  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"], "types": ["node"], "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true
